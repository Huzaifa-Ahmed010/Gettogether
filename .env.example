APP_NAME=GetTogether API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://gettogether:replace-with-url-safe-password@localhost:5432/gettogether
SECRET_KEY=replace-with-at-least-64-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXY_IPS=
REDIS_URL=
POSTGRES_DB=gettogether
POSTGRES_USER=gettogether
POSTGRES_PASSWORD=replace-with-the-same-url-safe-password
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRE_MINUTES=15
DEVELOPMENT_SHOW_EMAIL_OTP=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
